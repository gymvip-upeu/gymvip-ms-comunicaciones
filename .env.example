# ==============================================================================
# GYM VIP — Microservicio de Comunicaciones
# Variables de Entorno de Configuración (.env.example)
# NOTA: NUNCA colocar credenciales reales en este archivo.
# ==============================================================================

# Puerto del microservicio
PORT=8085

# Modo de operación: simulation (desarrollo/pruebas) | production (envíos reales)
COMMS_MODE=simulation

# Token de seguridad para comunicación servicio-a-servicio con gymvip-backend
COMMS_SERVICE_TOKEN=tu_token_secreto_interno_aqui

# ==============================================================================
# Configuración WhatsApp Business (Meta Cloud API)
# ==============================================================================
# Proveedor activo: meta | simulation
WHATSAPP_PROVIDER=meta

# Versión de Meta Graph API (ej. v20.0)
WHATSAPP_API_VERSION=v20.0

# ID del número de teléfono en Meta Cloud API (15 dígitos numéricos proporcionados por Meta)
WHATSAPP_PHONE_ID=

# Token de acceso de usuario del sistema (System User Access Token con permisos whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=

# ID de la cuenta comercial de WhatsApp (WABA ID)
WHATSAPP_WABA_ID=

# Identificador público @usuario del negocio (para descubrimiento del cliente, no reemplaza el número de destino)
WHATSAPP_HANDLE=@vipcenterfit

# Token de verificación para el registro del Webhook en el portal de Meta for Developers
WHATSAPP_WEBHOOK_VERIFY_TOKEN=tu_token_verificacion_webhook

# App Secret de Meta para validar firmas HMAC-SHA256 (X-Hub-Signature-256) en webhooks entrantes
WHATSAPP_APP_SECRET=
