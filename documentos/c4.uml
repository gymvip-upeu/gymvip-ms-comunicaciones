@startuml C4_Comunicaciones
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Contenedores C4 — Microservicio de Comunicaciones GYM VIP

Person(admin, "Administrador", "Personal administrativo de GYM VIP")
Person(member, "Socio / Cliente", "Cliente activo con membresía contratada")

System_Boundary(c1, "Ecosistema GYM VIP") {
    Container(spa, "Single Page Application", "React 18 / Vite", "Gestión de recordatorios HU-14 y consulta de estados HU-18")
    Container(backend, "Core API", "Spring Boot 3.4 / Java 21", "Evaluador de vencimientos, control de miembros y orquestador")
    Container(comms, "Microservicio de Comunicaciones", "Spring Boot 3.4 / H2 / JPA", "Despacho de WhatsApp, control de plantillas, auditoría y webhook")
    ContainerDb(db, "Base de Datos Intentos", "H2 / PostgreSQL", "Almacena communication_attempts e historial")
}

System_Ext(meta, "Meta Cloud API", "WhatsApp Business Platform v20.0")

Rel(admin, spa, "Configura recordatorios y consulta estados", "HTTPS")
Rel(spa, backend, "API REST JWT", "JSON / HTTPS")
Rel(backend, comms, "Despacho de avisos", "REST / X-Service-Key")
Rel(comms, db, "Persiste intentos y estados", "JPA / JDBC")
Rel(comms, meta, "Envía plantillas autorizadas", "HTTPS / REST")
Rel(meta, comms, "Webhook de eventos de entrega (sent, delivered, read)", "HTTPS POST")
Rel(meta, member, "Entrega mensaje a WhatsApp", "Red Móvil")

@enduml
